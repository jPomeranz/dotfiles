[user]
	name = Jacob Pomeranz
	email = jrpomeranz@yahoo.com 
[rerere]
	enabled = true
	autoupdate = true
[core]
	excludesfile = ~/.gitignore_global
	autocrlf = input
	editor = vim
[alias]
	br = branch
	ca = commit --amend
	ci = commit
	co = checkout
	cp = cherry-pick
	di = diff
	ds = diff --staged
	fixup = "!f() { TARGET=$(git rev-parse "$1"); git commit --fixup=$TARGET ${@:2} && GIT_EDITOR=true git rebase -i --autostash --autosquash $TARGET^; }; f"
	fp = fetch --prune
	gg = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all
	last = log -1 HEAD
	rb = rebase
	rbc = rebase --continue
	rbs = rebase --skip
	s = stash
	sa = stash apply
	sk = stash --keep-index
	sp = stash pop
	ss = stash show -p
	sst = stash push -S
	st = status
	su = stash --keep-index -u
	u = reset HEAD --
	undo = reset --soft HEAD^
	wta = worktree add -b
	wtl = worktree list
	wtr = worktree remove
[color]
	ui = auto
[status]
	showUntrackedFiles = all
[credential]
	helper = osxkeychain
[push]
	autoSetupRemote = true
	default = simple
	followTags = true
[pull]
	rebase = true
[column]
	ui = auto
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[init]
	defaultBranch = main
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
[help]
	autocorrect = prompt
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
